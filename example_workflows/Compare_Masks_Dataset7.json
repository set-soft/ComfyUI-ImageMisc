ame":"file_name","name":"file_name","type":"STRING","link":305},{"localized_name":"is_image","name":"is_image","type":"BOOLEAN","widget":{"name":"is_image"},"link":null},{"localized_name":"is_mask","name":"is_mask","type":"BOOLEAN","widget":{"name":"is_mask"},"link":null}],"outputs":[{"localized_name":"total_bytes","name":"total_bytes","type":"INT","links":null},{"localized_name":"human_readable","name":"human_readable","type":"STRING","links":[304]},{"localized_name":"file_name","name":"file_name","shape":6,"type":"STRING","links":[306]}],"properties":{"cnr_id":"image-misc","ver":"e105455bc7bf629ea61fa7f6fd677d1dca9a47cc","Node name for S&R":"SET_ImageMemoryEstimator","ue_properties":{"version":"7.0.1","widget_ue_connectable":{"is_image":true,"is_mask":true}},"widget_ue_connectable":{"is_image":true,"is_mask":true}},"widgets_values":["Number of images: 64<br>Minimum Dimensions: 266x400<br>Maximum Dimensions: 960x1080<br>Total Raw Tensor Size: 96.37 MiB (101049600 bytes)","Number of images: 64<br>Minimum Dimensions: 266x400<br>Maximum Dimensions: 960x1080<br>Total Raw Tensor Size: 385.47 MiB (404198400 bytes)","Number of images: 64<br>Minimum Dimensions: 266x400<br>Maximum Dimensions: 960x1080<br>Total Raw Tensor Size: 385.47 MiB (404198400 bytes)"],"color":"#2a363b","bgcolor":"#3f5159"},{"id":134,"type":"PreviewAny","pos":[940,2160],"size":[210,88],"flags":{},"order":16,"mode":0,"inputs":[{"localized_name":"source","name":"source","type":"*","link":293}],"outputs":[],"properties":{"cnr_id":"comfy-core","ver":"0.3.59","Node name for S&R":"PreviewAny","ue_properties":{"version":"7.0.1","widget_ue_connectable":{}},"widget_ue_connectable":{}},"widgets_values":[],"color":"#232","bgcolor":"#353"},{"id":147,"type":"MarkdownNote","pos":[-200,2150],"size":[625,250],"flags":{},"order":3,"mode":0,"inputs":[],"outputs":[],"properties":{"widget_ue_connectable":{}},"widgets_values":["# 1 Here we configure the paths\n\nDownload the dataset example from [SOD Evaluation Metrics](https://github.com/zyjwuyan/SOD_Evaluation_Metrics) repo.\n\nCopy the files to a subdir inside `ComfyUI/input`\n\nIn this example we asume the files are in `SOD` subdir, so `ComfyUI/input/SOD/gt/` contains the reference images\n\nThe first list contains the name of the methods we are comparing, and the second list the name of the datasets we are using.\n\nThe `Base path` node contains the above mentioned name: `SOD`\n\nThe `Path create` subgraph might look quite complex at first sight, but is just a description of the arbitrary paths used in the example.\n"],"color":"#432","bgcolor":"#653"},{"id":148,"type":"MarkdownNote","pos":[600,2250],"size":[275,250],"flags":{},"order":4,"mode":0,"inputs":[],"outputs":[],"properties":{"widget_ue_connectable":{}},"widgets_values":["# 2 Scanning the files\n\nThis node will generate the name of the files.\n\nIt will look for images in the `source` path. Once an image is found it will look for a file with the same name and `.csv` extension in the `destination`.\n\nIf the destination file is already generated it will be skipped.\n\nThis allows running the process in batches.\n\nThe outputs are the list of images to compare with their reference and the name of the results."],"color":"#432","bgcolor":"#653"},{"id":149,"type":"MarkdownNote","pos":[975,1725],"size":[275,250],"flags":{},"order":5,"mode":0,"inputs":[],"outputs":[],"properties":{"widget_ue_connectable":{}},"widgets_values":["# 3 Estimating the dataset size\n\nThese nodes can be used to estimate how much memory is needed for a copy of the images and their references when loaded in RAM.\n\nThe workflow needs more than one copy"],"color":"#432","bgcolor":"#653"},{"id":150,"type":"MarkdownNote","pos":[1375,1750],"size":[275,250],"flags":{},"order":6,"mode":0,"inputs":[],"outputs":[],"properties":{"widget_ue_connectable":{}},"widgets_values":["# 4 Loading the images\n\nThese nodes will load the images and their references.\n\nIn this example 64 images and 64 references are loaded to RAM. This is because we have two methods applied to two datasets of 16 images (2\\*2*16=64)\n\nFor large datasets you should disable the `show_preview` option and also set the `image_load_cap` in the node that creates the list. Limiting the number of images. You can then queue enough runs to cover the dataset.\n\n"],"color":"#432","bgcolor":"#653"},{"id":151,"type":"MarkdownNote","pos":[2075,1750],"size":[275,250],"flags":{},"order":7,"mode":0,"inputs":[],"outputs":[],"properties":{"widget_ue_connectable":{}},"widgets_values":["# 5 Compare\n\nFor real datasets the comparison might be an overkill, but here is quite illustrative"],"color":"#432","bgcolor":"#653"},{"id":152,"type":"MarkdownNote","pos":[1900,3300],"size":[275,250],"flags":{},"order":8,"mode":0,"inputs":[],"outputs":[],"properties":{"widget_ue_connectable":{}},"widgets_values":["# 6 Saliency Evaluation Metrics\n\nThis is the node where the metrics are computed. \n\nYou can disable the metrics you  don't need to speed-up the process.\n\nThe save options will save the individual metrics to a file with a name similar to the image, but with a corresponding suffix. "],"color":"#432","bgcolor":"#653"},{"id":153,"type":"MarkdownNote","pos":[2425,3300],"size":[275,250],"flags":{},"order":9,"mode":0,"inputs":[],"outputs":[],"properties":{"widget_ue_connectable":{}},"widgets_values":["# 7 Consolidating the metrics\n\nThis node will create a CSV for each method + dataset. \n\nThis spreadsheet will contain the data for all the images in the dataset\n\nA result for each combination is also stored at `res_destination`"],"color":"#432","bgcolor":"#653"},{"id":154,"type":"MarkdownNote","pos":[3025,2400],"size":[275,250],"flags":{},"order":10,"mode":0,"inputs":[],"outputs":[],"properties":{"widget_ue_connectable":{}},"widgets_values":["# 8 Plots\n\nThis node plots the same graphics found in the original repo.\n\nOne for each dataset comparing the two methods.\n\nYou can save them using the `Save Image` node, like usu